{
  "name": "im8",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "warn"
    }
  },
  "expo": {
    "autolinking": {},
    "install": {
      "exclude": ["typescript"]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:prod": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild",
    "prebuild:clean": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
    "nuke": "rm -rf ./node_modules ./ios ./android",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --quiet src",
    "test": "tsx --test src/**/__tests__/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/bip39": "1.6.0",
    "@scure/sr25519": "^2.3.0",
    "expo": "57.0.16",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.8",
    "eas-cli": "19.0.5",
    "eas-cli-local-build-plugin": "^18.13.1",
    "oxlint": "^1.74.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2"
  }
}
