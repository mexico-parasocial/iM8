{
  "name": "im8",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "warn"
    }
  },
  "expo": {
    "autolinking": {},
    "install": {
      "exclude": []
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:prod": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild",
    "prebuild:clean": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
    "nuke": "rm -rf ./node_modules ./ios ./android",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --quiet src",
    "test": "tsx --test src/**/__tests__/*.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/bip39": "1.6.0",
    "@scure/sr25519": "^2.3.0",
    "expo": "54.0.34",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~16.0.0",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.19.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "19.0.5",
    "eas-cli-local-build-plugin": "^18.13.1",
    "oxlint": "^1.74.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
