{
  "name": "im8",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.33.2",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "warn"
    }
  },
  "expo": {
    "autolinking": {},
    "install": {
      "exclude": []
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:prod": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild",
    "prebuild:clean": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
    "nuke": "rm -rf ./node_modules ./ios ./android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.34",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~16.0.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.19.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "19.0.5",
    "eas-cli-local-build-plugin": "^18.13.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native@0.81.5": "patches/react-native@0.81.5.patch"
    }
  },
  "overrides": {
    "glob": "^13.0.0",
    "inflight": "^1.0.6",
    "rimraf": "^5.0.0",
    "text-encoding": "^0.7.0",
    "uuid": "^9.0.0"
  }
}
